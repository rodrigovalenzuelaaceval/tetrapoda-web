---
// Icon — conjunto de iconos SVG (stroke, 24x24) para el catálogo de equipos.
interface Props {
  nombre: string;
}

const { nombre } = Astro.props;

const rutas: Record<string, string> = {
  camera:
    "M3 7h3l2-2h8l2 2h3a1 1 0 011 1v10a1 1 0 01-1 1H3a1 1 0 01-1-1V8a1 1 0 011-1z M12 17a4 4 0 100-8 4 4 0 000 8z",
  sound:
    "M11 5L6 9H3v6h3l5 4V5z M15.5 8.5a5 5 0 010 7 M18.5 5.5a9 9 0 010 13",
  rec:
    "M12 8v4l3 3 M12 21a9 9 0 100-18 9 9 0 000 18z M12 11a1 1 0 100-2 1 1 0 000 2z",
  gps:
    "M12 21s-7-5.1-7-11a7 7 0 0114 0c0 5.9-7 11-7 11z M12 12a2.5 2.5 0 100-5 2.5 2.5 0 000 5z",
  sensor:
    "M12 3v4 M12 17v4 M3 12h4 M17 12h4 M12 12a0 0 0 010-8a4 4 0 010 8z M12 12a4 4 0 010 8z",
  pack:
    "M4 7l8-4 8 4-8 4-8-4z M4 7v10l8 4 8-4V7 M12 11v10",
};

const fallback = rutas.camera;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  class="h-9 w-9 text-brand-orange"
  fill="none"
  viewBox="0 0 24 24"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d={rutas[nombre] ?? fallback} />
</svg>
