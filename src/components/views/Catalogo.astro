---
// Catalogo — Vista 2 · Catálogo de equipos y desarrollo tecnológico.
// Consume los datos compartidos de src/data/equipos.ts y los organiza
// visualmente en dos categorías: Línea Zéfiro y Arriendo de Equipos.
import { Image } from 'astro:assets';
import { equipos, type Producto } from '../../data/equipos';
import "./Catalogo.css";

interface Categoria {
  titulo: string;
  sub: string;
  descripcion: string;
  productos: Producto[];
  destaque?: boolean;
}

// Arquitectura visual conservada: tecnología propia (Zéfiro) primero.
const tecnologiaZefiro = equipos.filter((e) => e.slug.startsWith("zefiro-"));
const equiposArriendo = equipos.filter((e) => !e.slug.startsWith("zefiro-"));

const categorias: Categoria[] = [
  {
    titulo: "Desarrollo Tecnológico",
    sub: "Línea Zéfiro",
    descripcion: "Tecnología propia Tetrapoda® para el monitoreo automatizado de fauna.",
    destaque: true,
    productos: tecnologiaZefiro,
  },
  {
    titulo: "Arriendo de Equipos",
    sub: "Arriendo",
    descripcion: "Instrumentación de terreno para registro riguroso.",
    productos: equiposArriendo,
  },
];
---

<section id="equipos" class="border-b border-stone-200 bg-white py-24">
  <div class="mx-auto max-w-6xl px-6">
    <div class="max-w-2xl">
      <p class="text-xs font-semibold uppercase tracking-widest text-brand-orange">Catálogo</p>
      <h2 class="mt-3 font-display text-3xl font-bold text-stone-900 sm:text-4xl">
        Equipos de precisión, listos para operar en terreno
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-stone-600">
        Instrumentación real de arriendo y tecnología propia de monitoreo. Cada unidad se entrega configurada,
        testeada y acompañada de la documentación necesaria para el registro en campañas de campo.
      </p>
    </div>

    <div class="mt-14 space-y-14">
      {
        categorias.map((cat) => (
          <div class={cat.destaque ? "categoria categoria-destaque" : "categoria"}>
            <div class="categoria-head">
              <div>
                <p class="text-xs font-semibold uppercase tracking-widest text-brand-orange">{cat.sub}</p>
                <h3 class="mt-1 font-display text-2xl font-bold text-stone-900">{cat.titulo}</h3>
              </div>
              <p class="categoria-desc">{cat.descripcion}</p>
            </div>

            <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {
                cat.productos.map((p) => (
                  <article class="card">
                    {
                      p.imagen && (
                        <Image
                          src={p.imagen}
                          alt={p.nombre}
                          class="mb-4 w-full h-44 sm:h-52 rounded-xl object-contain p-2 md:p-4 bg-white/50"
                        />
                      )
                    }
                    <span class="card-idx">◆</span>
                    <h4 class="card-title">{p.nombre}</h4>
                    <p class="card-desc">{p.descripcion}</p>
                    <ul class="card-specs">
                      {
                        p.etiquetas.map((t) => (
                          <li class="card-spec">
                            <svg xmlns="http://www.w3.org/2000/svg" class="card-spec-check" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                            </svg>
                            <span>{t}</span>
                          </li>
                        ))
                      }
                    </ul>
                    <a href="#contacto" class="card-action">
                      {p.ctaTexto ?? "Consultar arriendo →"}
                    </a>
                    <a
                      href={`/equipos/${p.slug}`}
                      class="mt-2 inline-flex items-center gap-1 text-sm font-semibold text-brand-orange transition hover:text-brand-orange-glow"
                    >
                      Ver detalles →
                    </a>
                    {
                      p.servicioRelacionado && (
                        <a
                          href={p.servicioRelacionado.href}
                          class="mt-2 block text-xs font-medium text-stone-500 underline decoration-dotted underline-offset-2 hover:text-brand-orange"
                        >
                          {p.servicioRelacionado.texto}
                        </a>
                      )
                    }
                  </article>
                ))
              }
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

