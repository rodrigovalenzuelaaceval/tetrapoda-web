---
// Gracias — Página de confirmación tras el envío del formulario de contacto.
// Destino del redirect de Web3Forms. Útil también como meta de conversión
// si más adelante se instala Google Analytics / Google Ads.
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Solicitud recibida — Tetrapoda SpA"
  description="Confirmación de recepción de tu solicitud de cotización o consulta."
>
  <main>
    <section class="flex min-h-[60vh] items-center bg-white py-24">
      <div class="mx-auto max-w-2xl px-6 text-center">
        <span class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-brand-verde/10">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-brand-verde" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
        </span>
        <h1 class="mt-6 font-display text-3xl font-bold text-stone-900 sm:text-4xl">
          Recibimos tu solicitud
        </h1>
        <p class="mt-4 text-lg leading-relaxed text-stone-600">
          Gracias por escribirnos. Responderemos dentro de 48 horas hábiles con la configuración de equipos o
          servicio recomendado, junto a una cotización detallada.
        </p>
        <a
          href="/"
          class="mt-8 inline-block rounded-full bg-brand-orange px-8 py-3 font-semibold text-white shadow-lg transition hover:bg-brand-orange-flame"
        >
          Volver al inicio
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
