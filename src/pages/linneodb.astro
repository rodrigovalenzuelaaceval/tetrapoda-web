---
// LinneoDB Visualizador — página propia del visualizador interactivo de la
// base de datos LinneoDB. El HTML autocontenido se sirve como asset estático
// desde public/linneodb.html y se embebe en un iframe (sin reescritura de CSS).
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="LinneoDB Visualizador — Tetrapoda SpA"
  description="Visualizador interactivo de la base de datos LinneoDB: atributos y relaciones de fauna vertebrada terrestre chilena."
>
  <main>
    <!-- Hero corta -->
    <section class="bg-stone-900 py-20 text-stone-100 sm:py-24">
      <div class="mx-auto max-w-4xl px-6">
        <nav class="text-xs font-medium uppercase tracking-widest text-stone-500">
          <a href="/#webapp" class="text-brand-orange-glow hover:text-brand-orange-glow/80">
            Software propio
          </a>
          <span class="mx-2 text-stone-600">/</span>
          <span class="text-stone-300">LinneoDB Visualizador</span>
        </nav>
        <h1 class="mt-4 font-display text-4xl font-bold leading-tight text-white sm:text-5xl">
          LinneoDB Visualizador
        </h1>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-stone-300">
          Explora la base de datos propietaria LinneoDB con información exhaustiva de los vertebrados
          terrestres de Chile: atributos, relaciones y datos de referencia listos para tus campañas
          de campo y evaluaciones ambientales.
        </p>
      </div>
    </section>

    <!-- Visualizador embebido -->
    <section class="bg-stone-50 py-12">
      <div class="mx-auto max-w-6xl px-6">
        <div class="overflow-hidden rounded-2xl border border-stone-200 bg-white shadow-sm">
          <iframe
            src="/embeds/linneodb-visualizador.html"
            title="LinneoDB Visualizador"
            class="h-[85vh] w-full border-0"
            loading="lazy"
          ></iframe>
        </div>
        <p class="mt-4 text-center text-xs text-stone-500">
          Visualizador interactivo de la base de datos LinneoDB — Tetrapoda SpA
        </p>
      </div>
    </section>
  </main>
</BaseLayout>
