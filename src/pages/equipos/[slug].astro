---
// Página dinámica por equipo — /equipos/{slug}
// Genera una ruta por cada equipo del catálogo compartido (src/data/equipos.ts).
// Estructura: hero corta -> descripción -> especificaciones (chips + ficha) -> CTA.
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { equipos } from "../../data/equipos";
import type { Producto } from "../../data/equipos";

export function getStaticPaths() {
  return equipos.map((equipo) => ({
    params: { slug: equipo.slug },
    props: { equipo },
  }));
}

interface Props {
  equipo: Producto;
}

const { equipo } = Astro.props;

// Comentario de ficha técnica: placeholder a completar por Rod (sin datos de fabricante).
const fichaPlaceholders = [
  "[Completar: especificaciones técnicas reales del fabricante]",
  "[Completar: dimensiones y peso]",
  "[Completar: requisitos de alimentación y autonomía]",
];
---

<BaseLayout
  title={`${equipo.nombre} · Arriendo de equipos — Tetrapoda SpA`}
  description={equipo.descripcion}
>
  <main>
    <!-- Hero corta -->
    <section class="relative overflow-hidden bg-stone-900 py-20 text-stone-100 sm:py-24">
      {
        equipo.heroFondo && (
          <>
            <!-- Imagen de fondo (mismo patrón que src/components/views/Hero.astro) -->
            <Image
              src={equipo.heroFondo}
              alt=""
              class="absolute inset-0 w-full h-full object-cover z-0"
              style={`object-position: ${equipo.heroFondoPosition ?? "center"}`}
            />
            <!-- Overlay oscuro para legibilidad del texto -->
            <div class="absolute inset-0 bg-gray-900/60 z-10"></div>
          </>
        )
      }
      <div class="relative z-20 mx-auto max-w-4xl px-6">
        <nav class="text-xs font-medium uppercase tracking-widest text-stone-500">
          <a href="/#equipos" class="text-brand-orange-glow hover:text-brand-orange-glow/80">
            Equipos
          </a>
          <span class="mx-2 text-stone-600">/</span>
          <span class="text-stone-300">{equipo.nombre}</span>
        </nav>
        <p class="mt-6 inline-flex items-center gap-2 rounded-full border border-brand-orange/40 bg-brand-orange/10 px-4 py-1.5 text-xs font-semibold uppercase tracking-widest text-brand-orange-glow">
          {equipo.etiquetas[0]}
        </p>
        <h1 class="mt-4 font-display text-4xl font-bold leading-tight text-white sm:text-5xl">
          {equipo.nombre}
        </h1>
      </div>
    </section>

    <!-- Vista general -->
    {
      equipo.imagen && (
        <section class="bg-stone-50 py-16">
          <div class="mx-auto max-w-4xl px-6">
            <p class="text-xs font-semibold uppercase tracking-widest text-brand-orange">Vista general</p>
            <Image
              src={equipo.imagen}
              alt={`${equipo.nombre} — vista general`}
              class="mt-6 mx-auto w-full max-w-2xl rounded-2xl object-contain bg-white p-6"
            />
          </div>
        </section>
      )
    }

    <!-- Descripción -->
    <section class="border-b border-stone-200 bg-white py-16">
      <div class="mx-auto max-w-4xl px-6">
        <p class="text-xs font-semibold uppercase tracking-widest text-brand-orange">Descripción</p>
        {
          equipo.descripcionLarga ? (
            <div class="mt-5 space-y-5">
              {
                equipo.descripcionLarga.map((parrafo) => (
                  <p class="text-lg leading-relaxed text-stone-600">
                    {
                      parrafo.titulo && (
                        <span class="mb-1 block font-display font-semibold text-stone-900">
                          {parrafo.titulo}
                        </span>
                      )
                    }
                    {parrafo.texto}
                  </p>
                ))
              }
            </div>
          ) : (
            <p class="mt-5 text-lg leading-relaxed text-stone-600">
              {equipo.descripcion}
            </p>
          )
        }
      </div>
    </section>

    <!-- Especificaciones -->
    <section class="bg-stone-50 py-16">
      <div class="mx-auto max-w-4xl px-6">
        <p class="text-xs font-semibold uppercase tracking-widest text-brand-orange">Especificaciones</p>
        <div class="mt-5 flex flex-wrap gap-3">
          {
            equipo.etiquetas.map((t) => (
              <span class="rounded-full border border-stone-200 bg-white px-4 py-2 text-sm font-medium text-stone-700">
                {t}
              </span>
            ))
          }
        </div>

        <div class="mt-10 rounded-2xl border border-stone-200 bg-white p-6">
          <p class="text-xs font-semibold uppercase tracking-widest text-brand-orange">Ficha técnica del fabricante</p>
          {
            equipo.especificaciones ? (
              <ul class="mt-4 space-y-2.5 text-sm text-stone-600">
                {
                  equipo.especificaciones.map((spec) => (
                    <li class="flex items-start gap-2.5">
                      <svg xmlns="http://www.w3.org/2000/svg" class="mt-0.5 h-4 w-4 shrink-0 text-brand-verde" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                      </svg>
                      <span>{spec}</span>
                    </li>
                  ))
                }
              </ul>
            ) : (
              <>
                <!-- TODO(Rod): completar ficha técnica real (specs del fabricante) -->
                <ul class="mt-4 space-y-2 text-sm text-stone-500">
                  {
                    fichaPlaceholders.map((ph) => (
                      <li class="flex items-start gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" class="mt-0.5 h-4 w-4 shrink-0 text-stone-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4m0 4h.01M12 3a9 9 0 100 18 9 9 0 000-18z" />
                        </svg>
                        <span>{ph}</span>
                      </li>
                    ))
                  }
                </ul>
              </>
            )
          }
        </div>
      </div>
    </section>

    <!-- Incluye tu arriendo -->
    {
      equipo.incluye && (
        <section class="border-b border-stone-200 bg-white py-16">
          <div class="mx-auto max-w-4xl px-6">
            <p class="text-xs font-semibold uppercase tracking-widest text-brand-orange">Incluye tu arriendo</p>
            <ul class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-2">
              {
                equipo.incluye.map((item) => (
                  <li class="flex items-start gap-2.5 rounded-xl border border-stone-200 bg-stone-50 px-4 py-3 text-sm text-stone-700">
                    <svg xmlns="http://www.w3.org/2000/svg" class="mt-0.5 h-4 w-4 shrink-0 text-brand-verde" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                    <span>{item}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </section>
      )
    }

    <!-- Galería -->
    {
      equipo.galeria && (
        <section class="border-b border-stone-200 bg-white py-16">
          <div class="mx-auto max-w-4xl px-6">
            <p class="text-xs font-semibold uppercase tracking-widest text-brand-orange">Galería</p>
            <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-3">
              {
                equipo.galeria.map((foto) => (
                  <button
                    type="button"
                    data-lightbox-src={foto.src}
                    class="block w-full cursor-zoom-in overflow-hidden rounded-xl border-0 bg-transparent p-0 text-left"
                    aria-label="Ampliar foto de la galería"
                  >
                    <Image src={foto} alt="" class="rounded-xl object-cover w-full h-56" />
                  </button>
                ))
              }
            </div>
          </div>
        </section>
      )
    }

    <!-- CTA final -->
    <section class="bg-sage-900 py-16 text-stone-100">
      <div class="mx-auto max-w-4xl px-6 text-center">
        <h2 class="font-display text-3xl font-bold text-white sm:text-4xl">
          ¿Necesitas este equipo para tu campaña?
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-lg leading-relaxed text-stone-300">
          Cuéntanos las características de tu estudio y te asesoramos con la configuración de arriendo más adecuada.
        </p>
        <a
          href="/#contacto"
          class="mt-8 inline-block rounded-full bg-brand-orange px-8 py-3 font-semibold text-brand-black shadow-lg transition hover:bg-brand-orange-glow"
        >
          Consultar arriendo
        </a>
      </div>
    </section>
  </main>

  <!-- Lightbox minimalista de la galería (JS plano, sin dependencias) -->
  <div
    id="lightbox"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-black/85"
    role="dialog"
    aria-modal="true"
    aria-label="Foto ampliada de la galería"
  >
    <img
      id="lightbox-img"
      alt=""
      class="max-h-[90vh] max-w-[90vw] object-contain"
    />
    <button
      id="lightbox-close"
      type="button"
      aria-label="Cerrar vista ampliada"
      class="absolute right-4 top-4 flex h-10 w-10 items-center justify-center rounded-full border border-stone-500/60 bg-black/50 text-2xl leading-none text-white transition hover:bg-stone-800"
    >
      ✕
    </button>
  </div>
</BaseLayout>

<script>
  // Lightbox de la galería: muestra cada foto a tamaño completo.
  // Implementado con JS plano (querySelectorAll + addEventListener), sin dependencias.
  const lightbox = document.getElementById("lightbox");
  const lightboxImg = document.getElementById("lightbox-img");
  const lightboxClose = document.getElementById("lightbox-close");

  function openLightbox(src) {
    lightboxImg.src = src;
    lightbox.classList.remove("hidden");
    lightbox.classList.add("flex");
  }

  function closeLightbox() {
    lightbox.classList.add("hidden");
    lightbox.classList.remove("flex");
    lightboxImg.src = "";
  }

  // Abrir al hacer clic en cualquier miniatura con data-lightbox-src.
  document.querySelectorAll("[data-lightbox-src]").forEach((btn) => {
    btn.addEventListener("click", () => openLightbox(btn.dataset.lightboxSrc));
  });

  // Cerrar con el botón ✕.
  lightboxClose.addEventListener("click", closeLightbox);

  // Cerrar al hacer clic en el fondo oscuro (fuera de la imagen).
  lightbox.addEventListener("click", (event) => {
    if (event.target === lightbox) closeLightbox();
  });
</script>
