---
// Argos — Página de la aplicación web de cálculo de índices ecológicos.
// Se integra la aplicación autocontenida "Argos" (Diversitas · Índices Ecológicos)
// leyéndola en build-time desde el archivo original para conservar el 100% de su
// lógica de cliente, y se adapta su estética a la marca Tetrapoda (paneles oscuros,
// acentos naranjos y bordes técnicos) mediante una capa de override con CSS variables.
import BaseLayout from "../layouts/BaseLayout.astro";
import { readFileSync } from "node:fs";

const ARGOS_PATH = new URL("../../Argosv3_9_34_20260821.html", import.meta.url);
const html = readFileSync(ARGOS_PATH, "utf8");

const HEAD_END = html.indexOf("</head>");
const BODY_OPEN = html.indexOf("<body>");
const SCRIPT_OPEN = html.indexOf("<script>", BODY_OPEN);
const SCRIPT_END = html.lastIndexOf("</script>");
const headHtml = html.slice(0, HEAD_END);

// 1) Librerías externas (CDN) que Argos necesita: scripts js + css de leaflet.
const cdnTags = (
  (headHtml.match(/<script\s+src="[^"]+"><\/script>/g) || [])
    .concat(headHtml.match(/<link\s+rel="stylesheet"[^>]*>/g) || [])
).join("\n");

// 2) Hoja de estilos base de Argos (definida en el <head>).
const styleOpen = headHtml.indexOf("<style>");
const styleClose = headHtml.indexOf("</style>");
const appStyle = headHtml.slice(styleOpen + "<style>".length, styleClose).trim();

// 3) Marcado del <body> (sin el <body> y sin el <script> final).
const bodyInner = html.slice(BODY_OPEN + "<body>".length, SCRIPT_OPEN).trim();

// 4) Script principal con toda la lógica de cálculo y procesamiento en cliente.
const scriptOpenReal = html.indexOf(">", SCRIPT_OPEN) + 1;
const appScript = html.slice(scriptOpenReal, SCRIPT_END).trim();
---

<BaseLayout title="Argos · Índices Ecológicos de Fauna y Flora — Tetrapoda SpA">
  <div class="argos-shell">
    <!-- Librerías externas que usa Argos (procesamiento local en el navegador) -->
    <Fragment set:html={cdnTags} />

    <!-- Hoja de estilos base de la aplicación -->
    <style is:inline set:html={appStyle}></style>

    <!-- Marcado + lógica íntegra de Argos (se inyecta tal cual para no romper el bundle) -->
    <Fragment set:html={`${bodyInner}\n<script>${appScript}</script>`} />

    <!-- Capa de adaptación a la marca Tetrapoda (dark + naranjo corporativo) -->
    <style is:inline>
      :root{
        --slr:#FF7C00;         /* naranjo corporativo Tetrapoda (acento/CTA) */
        --ocre:#FFB45C;
        --ocre-bg:rgba(255,124,0,0.14);
        --ocre-text:#FFC988;
        --bg:#0e1210;         /* paneles oscuros */
        --bg2:#131914;
        --bg3:#1a211b;
        --text:#edf1ec;
        --text2:#a6aea7;
        --text3:#6f7870;
        --border:rgba(255,255,255,0.10);
        --border2:rgba(255,255,255,0.20);
        --r:10px;
        --rs:7px;
        --teal:#FF7C00;
        --tbg:rgba(255,124,0,0.14);
        --ttx:#FFB45C;
        --abg:rgba(255,124,0,0.10);
        --atx:#FFC988;
        --cbg:rgba(255,124,0,0.10);
        --ctx:#FFB45C;
        --bbg:rgba(29,48,38,0.7);
        --btx:#98d2b0;
        --gbg:rgba(29,48,38,0.7);
        --gtx:#c0e6cf;
      }
      .argos-shell{
        background:#0e1210;
        color:#edf1ec;
      }
      .argos-shell .topbar,
      .argos-shell .footer{
        background:#101310;
      }
      .argos-shell .gbtn,
      .argos-shell .okbtn{
        background:#FF7C00;
        color:#fff;
      }
      .argos-shell .gbtn:hover,
      .argos-shell .okbtn:hover{
        background:#FF3E03;
      }
    </style>
  </div>
</BaseLayout>
